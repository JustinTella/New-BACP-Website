# Web3Forms — one inbox per inquiry type. These are public keys: they ship in
# the browser bundle, so lock them to the site's domain in the Web3Forms
# dashboard rather than treating them as secrets. Defaults live in
# src/lib/formSubmit.ts; set these only to point a deploy at a different inbox.
VITE_WEB3FORMS_KEY_SELLING=succession_planning_access_key
VITE_WEB3FORMS_KEY_JOINING=joining_a_practice_access_key
VITE_WEB3FORMS_KEY_CAREERS=careers_access_key

# Ashby job board name, as it appears in jobs.ashbyhq.com/<name>.
# Defaults to "Blue Angel Clinical Partners".
VITE_ASHBY_JOB_BOARD=Blue Angel Clinical Partners

GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
